# ─────────────────────────────────────────────────────────────
# IT Ops Hub – Plantilla de variables de entorno
# Copiar a .env en la raíz y completar. NUNCA subir .env a Git.
# ─────────────────────────────────────────────────────────────

# Firebase principal (opcional; el login usa BacarPass abajo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── BacarPass – Auth + Firestore + Storage (proyecto legajosonline-959f6) ───
VITE_BACARPASS_PROJECT_ID=legajosonline-959f6
VITE_BACARPASS_APP_ID=1:753392336661:web:b2d23e3cc6aae7a0c4331c
VITE_BACARPASS_API_KEY=
VITE_BACARPASS_AUTH_DOMAIN=legajosonline-959f6.firebaseapp.com
VITE_BACARPASS_STORAGE_BUCKET=legajosonline-959f6.firebasestorage.app
VITE_BACARPASS_MESSAGING_SENDER_ID=753392336661

# Omada – variables VITE_* (referencia; el proxy usa OMADA_* abajo)
VITE_OMADA_BASE_URL=https://controlador:8043
VITE_OMADA_USERNAME=
VITE_OMADA_PASSWORD=

# Cámaras – ping desde el browser (IPs separadas por coma)
VITE_CAMERA_IPS=192.168.1.10,192.168.1.11
VITE_CAMERA_CHECK_PORT=80

# API externa de credenciales (opcional)
VITE_CREDENTIALS_API_URL=
VITE_CREDENTIALS_API_TOKEN=

# ── Proxy local (server/nvr-proxy.cjs) ───────────────────────
NVR_PROXY_PORT=3001

# NVRs: hasta 7 unidades (NVR_1_*, NVR_2_*, …). Omitir número si no existe.
# Canales: 1,2,3 | 1-48 | 1-16,33,34
# Marca: dahua | hikvision
NVR_1_NAME=NVR Planta
NVR_1_BASE_URL=http://192.168.0.100
NVR_1_USERNAME=admin
NVR_1_PASSWORD=
NVR_1_BRAND=dahua
NVR_1_CHANNELS=1-16

# ── Controlador Omada SDN (solo server-side) ─────────────────
OMADA_URL=https://controlador:8043
OMADA_USER=
OMADA_PASS=
OMADA_SITE_ID=Default

# ── Sistema de tickets (backend externo) ─────────────────────
TICKETS_API_URL=http://192.168.0.9:5040
TICKETS_ADMIN_EMAIL=
TICKETS_ADMIN_PASS=
