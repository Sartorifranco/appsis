# Firebase - rellenar y renombrar a .env
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Omada Controller (URL sin barra final; incluir puerto si no es 443)
VITE_OMADA_BASE_URL=https://omada.ejemplo.com:8043
VITE_OMADA_USERNAME=
VITE_OMADA_PASSWORD=

# ── Cámaras (IPs separadas por coma, para ping) ───────────────
VITE_CAMERA_IPS=192.168.1.10,192.168.1.11
VITE_CAMERA_CHECK_PORT=80

# ── NVR (credenciales SOLO server-side, nunca al browser) ──────
NVR_BRAND=hikvision
NVR_BASE_URL=http://192.168.1.100
NVR_USERNAME=admin
NVR_PASSWORD=
NVR_CHANNELS=1,2,3,4
NVR_PROXY_PORT=3001

# BacarPass – segunda app Firebase (legajosonline-959f6)
# Valores ya precargados; solo cambiar si se rota la app
VITE_BACARPASS_PROJECT_ID=legajosonline-959f6
VITE_BACARPASS_APP_ID=1:753392336661:web:b2d23e3cc6aae7a0c4331c
VITE_BACARPASS_API_KEY=AIzaSyCEaVNk-ccwOZ3mzDiITAztK0l4Qq6Cu2Y
VITE_BACARPASS_AUTH_DOMAIN=legajosonline-959f6.firebaseapp.com
VITE_BACARPASS_STORAGE_BUCKET=legajosonline-959f6.firebasestorage.app
VITE_BACARPASS_MESSAGING_SENDER_ID=753392336661

# API externa de contraseñas/credenciales
VITE_CREDENTIALS_API_URL=https://api.ejemplo.com/credentials
VITE_CREDENTIALS_API_TOKEN=
